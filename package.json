  "main": "index.js",
  "scripts": {
    "start": "npm run build && serve .",
    "build": "tsc",
    "build:site": "npm run build && node scripts/build-site.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,js,mjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,html,css}": "prettier --write"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/YekaterinaAlex/bulls-and-cows.git"
  },
  "keywords": [],
