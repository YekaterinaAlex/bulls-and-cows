  "bugs": {
    "url": "https://github.com/YekaterinaAlex/bulls-and-cows/issues"
  },
  "homepage": "https://github.com/YekaterinaAlex/bulls-and-cows#readme",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.6",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.14.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "prettier": "^3.9.10",
    "serve": "^14.2.6",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.1.0"
  }
